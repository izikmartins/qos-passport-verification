cat > .gitignore <<'EOF'
# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment
.env

# Identity documents - ignored by default
*.jpg
*.jpeg
*.png
*.pdf
*.webp
*.tif
*.tiff

# Allow approved FastMRZ sample
!data/
!data/passport_uk.jpg

# Temporary files
*.tmp
*.log
EOF